{
  "name": "psplus-sorter-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --var ALLOW_LOCALHOST:1",
    "db:init:local": "wrangler d1 execute psplus-sorter --local --file=schema.sql",
    "db:init": "wrangler d1 execute psplus-sorter --remote --file=schema.sql",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
