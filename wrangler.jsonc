// Serves wallofpsplus.com straight from the repository's files (Workers static assets).
// No Worker script on purpose: requests for static files are free and unlimited, but every request
// that runs a script counts toward the free plan's 100,000 a day, and a page view loads dozens of
// covers. The www address is sent to the bare domain by a Cloudflare Redirect Rule instead (see README).
{
  "name": "wallofpsplus",
  "compatibility_date": "2026-11-13",
  "assets": { "directory": "./" },
  "routes": [
    { "pattern": "wallofpsplus.com", "custom_domain": true },
    { "pattern": "www.wallofpsplus.com", "custom_domain": true }
  ],
  "workers_dev": true
}
